---
import Layout from '../layouts/Layout.astro';

const modules = import.meta.glob('../content/ue*.mdx', { eager: true });
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const ues = Object.entries(modules)
  .map(([path, mod]: [string, any]) => {
    const slug = path.split('/').pop()!.replace('.mdx', '');
    const fm = mod.frontmatter ?? {};

    const parts = (fm.title as string ?? '').split(' — ');
    let label: string, name: string;
    if (parts.length >= 2) {
      label = parts[0].replace(/^(UE)(\d+)$/, '$1 $2');
      name = parts.slice(1).join(' — ');
    } else {
      label = `UE ${slug.replace('ue', '')}`;
      name = (fm.title as string ?? slug).replace(/^UE\s*\d*\s*/, '').trim();
    }

    const navItems = [...(fm.coursNav ?? []), ...(fm.fichesNav ?? [])];
    const desc = navItems.slice(0, 3).map((n: any) => n.label).join(', ');

    return { slug, label, name, desc, color: fm.color ?? 'c1' };
  })
  .sort((a, b) => {
    const na = parseInt(a.slug.replace('ue', '')) || 999;
    const nb = parseInt(b.slug.replace('ue', '')) || 999;
    return na - nb;
  });
---
<Layout title="Révisions Master IFMK">
  <div id="home">
    <div class="home-hero">
      <h1>Révisions Master IFMK</h1>
      <p>Sélectionnez une UE pour commencer</p>
    </div>
    <div class="ue-grid">
      {ues.map(({ slug, label, name, desc, color }) => (
        <a href={`${base}/${slug}`} class="ue-card" style={`--accent: var(--${color})`}>
          <div class="ue-label">{label}</div>
          <div class="ue-name">{name}</div>
          <div class="ue-desc">{desc}</div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  #home {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: var(--bg);
  }

  .home-hero {
    text-align: center;
    margin-bottom: 48px;
  }
  .home-hero h1 {
    font-size: 28px;
    font-weight: 800;
    color: var(--tx);
    margin-bottom: 8px;
  }
  .home-hero p {
    color: var(--mu);
    font-size: 15px;
  }

  .ue-grid {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .ue-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: var(--s1);
    border: 2px solid var(--bd);
    border-radius: 16px;
    padding: 32px 28px;
    width: 280px;
    text-decoration: none;
    color: var(--tx);
    transition: border-color .2s, transform .15s;
  }
  .ue-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .ue-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .08em;
    color: var(--mu);
    text-transform: uppercase;
  }
  .ue-name {
    font-size: 17px;
    font-weight: 700;
    text-align: center;
    color: var(--accent);
  }
  .ue-desc {
    font-size: 12px;
    color: var(--mu);
    text-align: center;
    line-height: 1.5;
  }
</style>
